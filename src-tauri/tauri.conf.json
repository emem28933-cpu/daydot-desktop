{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daydot",
  "version": "0.8.0",
  "identifier": "app.daydot.desktop",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Daydot",
        "url": "https://deluxe-cucurucho-d8c3ad.netlify.app",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ]
      }
    }
  }
}